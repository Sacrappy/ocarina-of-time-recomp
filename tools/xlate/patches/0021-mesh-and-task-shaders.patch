+                Operand threadId = context.Load(StorageKind.Input, IoVariable.ThreadId, null, Const(0));
+                Operand index = Local();
+                Operand lblHead = Label();
+                Operand lblDone = Label();
+
+                context.Copy(index, threadId);
+                context.MarkLabel(lblHead);
+                context.BranchIfTrue(lblDone, context.ICompareGreaterOrEqualUnsigned(index, Const(words)));
