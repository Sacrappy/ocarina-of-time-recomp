+using System;
+using Ryujinx.Graphics.Shader.Decoders;
+using Ryujinx.Graphics.Shader.IntermediateRepresentation;
+using Ryujinx.Graphics.Shader.Translation;
+using static Ryujinx.Graphics.Shader.Instructions.InstEmitHelper;
+using static Ryujinx.Graphics.Shader.IntermediateRepresentation.OperandHelper;
+
+namespace Ryujinx.Graphics.Shader.Instructions
+{
+    // Task and mesh stages (SPV_EXT_mesh_shader). The SM86 lowering keeps ISBERD/ISBEWR as one pseudo instruction
+    // (runtime/sm86_lower.h SM86_ISBE_OP) and every EXIT branches to SM86_MESH_EPILOGUE, expanded here.
+    //
+    // The stage buffer is one shared array per program (ResourceManager.SetMeshStageBuffer). Its layout, from the
+    // game's code (docs/mesh.md):
+    //   TASK  0 is the workgroup index (the hardware preloads it), 4 the mesh workgroup count, the payload from 0x10;
+    //   ATTR  at MeshStageAttrBase: one 0x80-byte line per output component, vertex v's line k at
+    //         (v >> 5) * lines * 0x80 + k * 0x80 + (v & 31) * 4;
+    //   MAP   at MeshStageMapBase: the primitive count as a byte at +3, triangle p's three U8 indices from 4 + 3p.
+    // A task program's payload goes to its own shared array (MeshTaskPayloadMemoryId) and is copied into the SPIR-V
+    // payload variable in the epilogue; a mesh program of a task pipeline reads that variable (there is no shared
+    // memory between the two stages of a pipeline).
+    static partial class InstEmit
+    {
+        // ISBERD (write false) or ISBEWR (write true) on the stage buffer. The address register already holds the
+        // vertex group's and vertex's byte offset, so the byte address is the space's base + register + offset.
+        public static void Isbe(EmitterContext context)
+        {
+            InstIsbe op = context.GetOp<InstIsbe>();
+            TranslatorContext translator = context.TranslatorContext;
+            ShaderDefinitions definitions = translator.Definitions;
+            int stageId = context.ResourceManager.MeshStageBufferId;
+
+            if (stageId < 0 || definitions.Stage is not (ShaderStage.Task or ShaderStage.Mesh))
+            {
+                translator.GpuAccessor.Log("ISBE outside a task or mesh program.");
+                return;
+            }
+
+            Operand address = context.IAdd(GetSrcReg(context, op.SrcA), Const(op.Offset));
+
+            if (op.Space == 0x7)
+            {
+                EmitTaskSpace(context, definitions, stageId, op, address);
+                return;
+            }
+
+            int baseAddress = op.Space switch
+            {
+                0xf => definitions.MeshStageAttrBase,
+                0x1 or 0x0 => definitions.MeshStageMapBase,
+                _ => -1,
+            };
+
+            if (baseAddress < 0)
+            {
+                translator.GpuAccessor.Log($"ISBE space {op.Space} is not used by task or mesh programs.");
+                return;
+            }
+
+            address = baseAddress == 0 ? address : context.IAdd(address, Const(baseAddress));
+
+            if (!op.Write)
+            {
+                // ISBERD reads a 32-bit word (the address is word-aligned in every capture).
+                Operand word = context.ShiftRightU32(address, Const(2));
+                context.Copy(GetDest(op.Dest), context.Load(StorageKind.SharedMemory, stageId, word));
+            }
+            else if (op.Space is 0x0 or 0x1)
+            {
+                // MAP.U8: one triangle index. MAP.32 at +3: the primitive count, whose low byte is the only one that
+                // can be non-zero (at most 96 primitives) and the only one the epilogue reads. Both are byte stores
+                // into the word array, a read-modify-write of the containing word.
+                StoreByte(context, stageId, address, GetSrcReg(context, op.Dest));
+            }
+            else
+            {
+                // ATTR: one 32-bit vertex output component (the address is 4-byte aligned).
+                Operand word = context.ShiftRightU32(address, Const(2));
+                context.Store(StorageKind.SharedMemory, stageId, word, GetSrcReg(context, op.Dest));
+            }
+        }
+
+        private static void EmitTaskSpace(
+            EmitterContext context,
+            ShaderDefinitions definitions,
+            int stageId,
+            InstIsbe op,
+            Operand address)
+        {
+            if (!op.Write)
+            {
+                if (definitions.MeshPayloadSize > 0 && definitions.Stage == ShaderStage.Mesh)
+                {
+                    // A mesh program of a task pipeline reads the payload the task wrote, and 0 is its workgroup
+                    // index (the hardware's own value, not part of the payload).
+                    if (op.Offset < 0x10)
+                    {
+                        context.Copy(GetDest(op.Dest), op.Offset == 0 && op.SrcA == RegisterConsts.RegisterZeroIndex
+                            ? context.Load(StorageKind.Input, IoVariable.CtaId, null, Const(0))
+                            : Const(0));
+                    }
+                    else
+                    {
+                        context.Copy(GetDest(op.Dest), context.MeshLoadPayload(Const((op.Offset - 0x10) >> 2)));
+                    }
+                    return;
+                }
+
+                // Without a payload variable the task space is the first words of the stage buffer (0: workgroup
+                // index, 4: count), filled by EmitStart and by Isbe's own writes.
