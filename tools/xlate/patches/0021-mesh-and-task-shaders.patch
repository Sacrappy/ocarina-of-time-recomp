+            // A count above the mesh's declared maximum is undefined in Vulkan (and takes the device down): clamp it.
+            primitives = context.IMinimumU32(primitives, Const(definitions.MaxMeshOutputPrimitives));
+
+            context.MeshSetOutputs(Const(definitions.MaxOutputVertices), primitives);
+
+            int lines = definitions.MeshOutputLines.Length;
+            int groups = (definitions.MaxOutputVertices + 31) / 32;
+
+            // The stage buffer holds `groups` groups of 32 vertices (docs/mesh.md): word (g * lines + line) * 32 + v.
+            // An invocation takes vertex v = its lane in the group, and (workgroup size / 32) groups at a time: the
+            // workgroup size is the control section's (32 in every capture, but Vulkan allows up to 128 invocations).
+            int workgroup = Math.Max(1, definitions.ComputeLocalSizeX);
+            int groupStep = Math.Max(1, workgroup / 32);
+            int iterations = (groups + groupStep - 1) / groupStep;
+            Operand lane = context.BitwiseAnd(threadId, Const(31));
+            Operand groupBase = context.ShiftRightU32(threadId, Const(5));
+
+            for (int iteration = 0; iteration < iterations; iteration++)
+            {
+                Operand group = iteration == 0 ? groupBase : context.IAdd(groupBase, Const(iteration * groupStep));
