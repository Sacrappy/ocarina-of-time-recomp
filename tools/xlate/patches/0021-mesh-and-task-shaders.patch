+            }
+
+            // Every lane takes the primitives it wrote: p = lane, lane + workgroup size, ...
+            Operand primitive = Local();
+            Operand lblHead = Label();
+            Operand lblDone = Label();
+
+            context.Copy(primitive, threadId);
+            context.MarkLabel(lblHead);
+            context.BranchIfTrue(lblDone, context.ICompareGreaterOrEqualUnsigned(primitive, primitives));
+
+            Operand indices = context.IMultiply(primitive, Const(3));
+            indices = context.IAdd(indices, Const(definitions.MeshStageMapBase + 4));
+
+            Operand i0 = LoadMapByte(context, stageId, indices, 0);
+            Operand i1 = LoadMapByte(context, stageId, indices, 1);
+            Operand i2 = LoadMapByte(context, stageId, indices, 2);
