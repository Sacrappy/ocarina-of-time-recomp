+            // A vertex index at or above the declared vertex count is undefined in Vulkan and can take the device
+            // down; the game's own indices are below maxV, so this only guards a bad stage buffer.
+            Operand lastVertex = Const(definitions.MaxOutputVertices - 1);
+            i0 = context.IMinimumU32(i0, lastVertex);
+            i1 = context.IMinimumU32(i1, lastVertex);
+            i2 = context.IMinimumU32(i2, lastVertex);
+
+            context.MeshSetPrimitive(primitive, i0, i1, i2);
+
+            context.Copy(primitive, context.IAdd(primitive, Const(workgroup)));
+            context.Branch(lblHead);
+            context.MarkLabel(lblDone);
+        }
+
+        private static Operand LoadMapByte(EmitterContext context, int stageId, Operand baseAddress, int add)
+        {
+            Operand address = context.IAdd(baseAddress, Const(add));
+            Operand word = context.Load(StorageKind.SharedMemory, stageId, context.ShiftRightU32(address, Const(2)));
+            Operand shift = context.ShiftLeft(context.BitwiseAnd(address, Const(3)), Const(3));
+
+            return context.BitwiseAnd(context.ShiftRightU32(word, shift), Const(0xff));
+        }
+
+        private static void EmitTaskOutputs(EmitterContext context, ShaderDefinitions definitions, int payloadId)
+        {
